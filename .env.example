# Copy this file to .env and fill in your local Postgres credentials.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/rcm_tickets

# Used by the generation pipeline (generation/) to reach the local Ollama
# server. No API key needed -- Ollama runs entirely on this machine. Only
# needed if your Ollama server isn't on the default host/port.
# OLLAMA_HOST=http://localhost:11434

# recommender/ pipeline (Milestone 1+). Points at the pgvector-enabled
# Postgres container (docker run ... pgvector/pgvector:pg16 -p 5433:5432),
# kept separate from the native Postgres instance DATABASE_URL above uses.
RECOMMENDER_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/rcm_tickets
